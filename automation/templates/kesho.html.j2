{#- Kesho Kutwa inner slide. Fields: n, total, headline, leo, kesho, anza -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 520px; }
.num { font-size: 150px; line-height: .8; font-weight: 900; letter-spacing: -.05em; color: var(--accent); }
.headline { margin-top: 30px; font-size: {{ fitw(headline, 936, 3, 100 if photo_uri is not defined else 76) }}px; }
.cmp > div { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding: 24px 0; border-top: 2px solid var(--line); }
.cmp > div:last-child { border-bottom: 2px solid var(--line); }
.cmp .label { margin: 6px 0 0; }
.cmp .old .label { color: var(--muted); }
.try { margin-top: 30px; border-left: 6px solid var(--accent); padding: 4px 0 4px 28px; }
{% endblock %}
{% block top %}<span class="tag">Kesho Kutwa</span><span class="meta">{{ n }} / {{ total }}</span>{% endblock %}
{% block content %}
  <p class="display num">{{ '%02d' % n }}</p>
  <h1 class="display headline">{{ headline | mark }}</h1>
  <div class="gap"></div>
  <div class="cmp">
    <div class="old"><p class="label">Today</p><p class="body">{{ leo | nb }}</p></div>
    <div><p class="label">Tomorrow</p><p class="strong">{{ kesho | nb }}</p></div>
  </div>
  <div class="try"><p class="label">Try it now</p><p class="body">{{ anza | nb }}</p></div>
{% endblock %}
