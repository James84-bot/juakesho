{#- AI Hack — one move that saves real time. Fields: hook, title, moves (2-4), payoff, series? -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 600px; }
.title { font-size: {{ fitw(title, 936, 4, 124 if photo_uri is not defined else 84) }}px; }
.payoff { margin-top: 30px; }
{% endblock %}
{% block top %}<span class="tag">{{ series | default('AI Hack') }}</span><span class="meta">Save this</span>{% endblock %}
{% block content %}
  <p class="label">{{ hook }}</p>
  <h1 class="display title">{{ title | mark }}</h1>
  <div class="gap"></div>
  <div class="rows">
    {% for m in moves %}<div class="row"><span class="n">{{ '%02d' % loop.index }}</span><span>{{ m | nb }}</span></div>{% endfor %}
  </div>
  <p class="strong payoff">{{ payoff }}</p>
{% endblock %}
