{#- Put Us On — spotlight an African artist, creator, startup or public servant doing good. Positive only; needs a source.
    With their real photo (person_photo + rights) the photo leads. Fields: kind, name, country, what, why, cta -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 700px; }
.name { font-size: {{ fitw(name, 936, 2, 190 if photo_uri is not defined else 120) }}px; letter-spacing: -.035em; }
.country { margin-top: 18px; font: 800 26px/1 "Inter Tight"; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
.what { margin-top: 34px; }
.cta { margin-top: 26px; }
{% endblock %}
{% block top %}<span class="tag">Put Us On</span><span class="meta">{{ kind }}</span>{% endblock %}
{% block content %}
  {% if photo_uri is not defined %}<p class="label">You should know about</p>{% endif %}
  <h1 class="display name">{{ name }}</h1>
  <p class="country">{{ country }}</p>
  <p class="lead what">{{ what | nb }}</p>
  <div class="gap"></div>
  <p class="label">Why it matters</p>
  <p class="body">{{ why | nb }}</p>
  <p class="strong cta">{{ cta }}</p>
{% endblock %}
