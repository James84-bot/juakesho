{#- Put Us On — spotlight an African artist, creator or startup. Positive only; needs a source.
    Fields: kind, name, country, what, why, cta -#}
{% extends "base.html.j2" %}
{% block style %}
.series { position: absolute; top: 84px; left: 84px; background: var(--jua); color: var(--usiku); }
.kind { position: absolute; top: 84px; right: 84px; background: rgba(255,255,255,.16); color: #fff; border: 1.5px solid rgba(255,255,255,.4); }
.lead { position: absolute; left: 84px; top: 180px; font-size: 58px; color: var(--pwani); }
.name { position: absolute; left: 60px; right: 60px; top: 250px; font-size: {{ fitw(name, 940, 2, 150) }}px; color: #fff; text-shadow: 0 0 50px rgba(255,255,255,.3); }
.country { position: absolute; left: 84px; top: 540px; font: 800 30px "Unbounded"; color: var(--jua); letter-spacing: .02em; }
.what { position: absolute; left: 70px; right: 70px; top: 610px; padding: 34px 40px; font-size: 34px; font-weight: 700; line-height: 1.28; }
.why { position: absolute; left: 70px; right: 70px; top: 850px; padding: 30px 40px; font-size: 30px; line-height: 1.3; }
.why b { font-family: "Caveat"; font-size: 44px; color: var(--jacaranda); margin-right: 10px; }
.cta { position: absolute; left: 84px; right: 84px; top: 1090px; font-size: 48px; color: var(--jua); text-align: center; transform: rotate(-2deg); }
{% endblock %}
{% block backdrop %}{{ aurora(W, H, seed, colors=[C.jua, C.chai, C.jacaranda, C.pwani]) }}{% endblock %}
{% block art %}
  {{ orbit(W - 200, 330, 190, 60, -12, C.jua, seed, planets=2) }}
{% endblock %}
{% block content %}
  <span class="pill series">Put Us On</span>
  <span class="pill kind">{{ kind }}</span>
  <p class="hook lead">you should know about&hellip;</p>
  <h1 class="display name">{{ name }}</h1>
  <p class="country">{{ country }}</p>
  <p class="glass what">{{ what | nb }}</p>
  <p class="glass glass--light why"><b>Why it matters:</b>{{ why | nb }}</p>
  <p class="hook cta">{{ cta }}</p>
{% endblock %}
