{#- Decode — the tech word everyone's saying. Fields: hook, word, meaning, try_this, number -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 560px; }
.word { font-size: {{ fit(word, 936, 210 if photo_uri is not defined else 170) }}px; letter-spacing: -.04em; line-height: .92; }
.meaning { margin-top: 40px; }
.try { border-left: 6px solid var(--accent); padding: 4px 0 4px 28px; }
{% endblock %}
{% block top %}<span class="tag">{{ series | default('Decode') }}</span><span class="meta">No. {{ number }}</span>{% endblock %}
{% block content %}
  <p class="label">{{ hook }}</p>
  <h1 class="display word">{{ word }}</h1>
  <p class="lead meaning">{{ meaning | nb }}</p>
  <div class="gap"></div>
  <div class="try"><p class="label">Try this</p><p class="body">{{ try_this | nb }}</p></div>
{% endblock %}
