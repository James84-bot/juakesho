{#- Decode — the tech word everyone's saying. Fields: hook, word, meaning, try_this, number -#}
{% extends "base.html.j2" %}
{% block style %}
.series { position: absolute; top: 84px; left: 84px; background: var(--pwani); color: var(--usiku); }
.no { position: absolute; top: 90px; right: 84px; font: 800 26px "Unbounded"; color: var(--pwani); }
.hook { position: absolute; left: 84px; top: 170px; font-size: 56px; color: var(--jua); transform: rotate(-2deg); }
.word { position: absolute; left: 60px; right: 60px; top: 250px; text-align: center; font-size: {{ fit(word, 940, 230) }}px; color: #fff;
  text-shadow: 0 0 60px rgba(255,255,255,.35); }
{% if symbol %}.word { right: 440px; text-align: left; font-size: {{ fit(word, 580, 190) }}px; }{% endif %}
.card { position: absolute; left: 70px; right: 70px; top: 610px; padding: 40px 44px; }
.card p { font-size: 38px; font-weight: 700; line-height: 1.28; }
.try { position: absolute; left: 70px; right: 70px; top: 930px; padding: 30px 40px; font-size: 30px; line-height: 1.3; }
.try b { font-family: "Caveat"; font-size: 44px; color: var(--usiku); margin-right: 10px; }
.mascot { position: absolute; right: 50px; top: 480px; width: 170px; height: 170px; }
{% endblock %}
{% block backdrop %}{{ aurora(W, H, seed, colors=[C.ziwa, C.jacaranda, C.pwani, C.waridi]) }}{% endblock %}
{% block art %}
{% endblock %}
{% block content %}
  <span class="pill series">{{ series | default('Decode') }}</span>
  <span class="no">No. {{ number }}</span>
  <p class="hook">{{ hook }}</p>
  <h1 class="display word">{{ word }}</h1>
  <div class="glass card"><p>{{ meaning | nb }}</p></div>
  <svg class="mascot" viewBox="0 0 200 200">{{ mascot('wink') }}</svg>
  <p class="glass glass--light try"><b>Try this:</b>{{ try_this | nb }}</p>
{% endblock %}
