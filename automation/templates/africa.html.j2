{#- Made in Africa — African firsts and innovation. Fields: year, name, country, fact, now -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 560px; }
.year { font-size: {{ 280 if photo_uri is not defined else 200 }}px; line-height: .82; letter-spacing: -.055em; font-weight: 900; color: var(--accent); }
.name { margin-top: 28px; font-size: {{ fitw(name, 936, 2, 150) }}px; }
.fact { margin-top: 34px; }
{% endblock %}
{% block top %}<span class="tag">Made in Africa</span><span class="meta">{{ country }}</span>{% endblock %}
{% block content %}
  <p class="display year">{{ year }}</p>
  <h1 class="display name">{{ name }}</h1>
  <p class="lead fact">{{ fact | nb }}</p>
  <div class="gap"></div>
  <p class="strong">{{ now }}</p>
{% endblock %}
