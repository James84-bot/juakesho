{#- Makanga Explains — a tech idea explained through everyday Kenyan life (the matatu, the stage, the chama).
    Fields: topic, like, explain, punch, expr -#}
{% extends "base.html.j2" %}
{% block style %}
.topic { font-size: {{ fitw(topic, 936, 2, 136) }}px; }
.like { margin-top: 36px; padding: 34px 38px; border-radius: 4px; background: var(--ink-950); color: #fff;
  font-size: {{ fitw(like, 860, 3, 84) }}px; line-height: 1.04; }
.punch { margin-top: 26px; }
{% endblock %}
{% block top %}<span class="tag">Explained simply</span><span class="meta">Makanga explains</span>{% endblock %}
{% block content %}
  <h1 class="display topic">{{ topic | mark }}</h1>
  <p class="label" style="margin: 26px 0 0">is like&hellip;</p>
  <p class="display like">{{ like }}</p>
  <div class="gap"></div>
  <p class="lead">{{ explain | nb }}</p>
  <p class="strong punch">{{ punch }}</p>
{% endblock %}
