{#- POV: 2030 — a near-future scenario as a POV, then the real talk.
    Fields: year, pov, real, cast (list of {who, pose, mood, phone}) -#}
{% extends "base.html.j2" %}
{% block style %}
.series { position: absolute; top: 84px; left: 84px; background: var(--pwani); color: var(--usiku); }
.year { position: absolute; right: 84px; top: 70px; font: 800 64px "Unbounded"; color: var(--jua); letter-spacing: -.04em; text-shadow: 0 0 36px rgba(255,198,41,.5); }
.pov { position: absolute; left: 84px; right: 84px; top: 190px; font-size: {{ fitw("POV: " ~ pov, 912, 4, 74) }}px; line-height: 1.08; color: #fff; }
.pov b { color: var(--pwani); }
.stage { position: absolute; left: 70px; right: 70px; top: 610px; height: 330px; }
.real { position: absolute; left: 70px; right: 70px; top: 970px; padding: 30px 40px; font-size: 30px; font-weight: 600; line-height: 1.32; }
.real b { font-family: "Caveat"; font-size: 44px; color: var(--jua); margin-right: 10px; }
{% endblock %}
{% block backdrop %}{{ aurora(W, H, seed, colors=[C.jacaranda, C.ziwa, C.pwani, C.waridi]) }}{% endblock %}
{% block art %}
  {{ circuit(0, 560, W, 420, C.pwani, seed, traces=6) }}
{% endblock %}
{% block content %}
  <span class="pill series">POV: Kesho</span>
  <span class="year">{{ year }}</span>
  <h1 class="display pov"><b>POV:</b> {{ pov }}</h1>
  <div class="glass stage">
    <svg viewBox="0 0 940 330" width="940" height="330">
      {% set xs = [180, 470, 760] %}
      {% for c in cast %}
        {% if c.who == 'jua' %}<g transform="translate({{ xs[loop.index0] - 90 }} 110) scale(0.9)">{{ mascot(c.mood | default('visor')) }}</g>
        {% else %}{{ stick(c.who, xs[loop.index0], 300, c.pose | default('stand'), c.mood | default('happy'), 1.05, c.phone | default(false), '#FFF4E0') }}{% endif %}
      {% endfor %}
    </svg>
  </div>
  <p class="glass real"><b>Real talk:</b>{{ real | nb }}</p>
{% endblock %}
