{#- First post / pinned intro. Fields: hello, promise (list), community -#}
{% extends "base.html.j2" %}
{% block style %}
.logo { width: 560px; display: block; margin-top: 10px; }
.tag-line { margin-top: 44px; font-size: 76px; }
.rows .n { color: var(--ink-950); }
{% endblock %}
{% block top %}<span class="tag">{{ hello }}</span><span class="meta">Est. 2026 · Nairobi</span>{% endblock %}
{% block content %}
  <img class="logo" src="{{ logo_stacked }}" alt="Wanjiku Asks">
  <h1 class="display tag-line">{{ brand.tagline_sw }}</h1>
  <div class="gap"></div>
  <div class="rows">
    {% for p in promise %}<div class="row"><span class="n"></span><span>{{ p }}</span></div>{% endfor %}
  </div>
  <p class="strong" style="margin-top: 28px">{{ community }}</p>
{% endblock %}
