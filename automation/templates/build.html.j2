{#- Build With Me — a real build, shown as a workflow. Fields: hook, title, flow (3-6), stack (list), result -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 520px; }
.title { font-size: {{ fitw(title, 936, 4, 104 if photo_uri is not defined else 72) }}px; }
.rows .row { padding: {{ 16 if flow | length > 4 else 20 }}px 0; font-size: {{ 27 if flow | length > 4 else 29 }}px; }
.stack { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
.stack span { padding: 9px 14px 8px; border: 2px solid var(--line); border-radius: 4px; font: 700 20px/1 "Inter Tight"; letter-spacing: .06em;
  text-transform: uppercase; color: var(--soft); }
.result { margin-top: 24px; }
{% endblock %}
{% block top %}<span class="tag">Build With Me</span><span class="meta">How it works</span>{% endblock %}
{% block content %}
  <p class="label">{{ hook }}</p>
  <h1 class="display title">{{ title | mark }}</h1>
  <div class="gap"></div>
  <div class="rows">
    {% for step in flow %}<div class="row"><span class="n">{{ '%02d' % loop.index }}</span><span>{{ step | nb }}</span></div>{% endfor %}
  </div>
  <div class="stack">{% for s in stack %}<span>{{ s }}</span>{% endfor %}</div>
  <p class="strong result">{{ result }}</p>
{% endblock %}
