{#- Your Say — story poll (1080x1920). Fields: hook, question, options (2), cta -#}
{% extends "base.html.j2" %}
{% block style %}
.top { top: 220px; }
.layer { padding-top: 340px; padding-bottom: 300px; }
.has-photo { --ph: 900px; }
.has-photo .layer { padding-top: 760px; }
.q { font-size: {{ fitw(question, 936, 5, 150) }}px; }
.opts { display: grid; gap: 22px; margin-top: 60px; }
.opts div { display: grid; grid-template-columns: 70px 1fr; align-items: center; padding: 34px 36px; border: 3px solid var(--line); border-radius: 12px;
  font: 800 46px/1.1 "Inter Tight"; letter-spacing: -.015em; }
.opts span { font-size: 30px; color: var(--accent); }
.cta { margin-top: 44px; }
.foot { bottom: 250px; }
{% endblock %}
{% block top %}<span class="tag">{{ series if series is defined and series else 'Your Say' }}</span><span class="meta">{{ 'Quiz' if series is defined and series == 'Guess the Price' else 'Poll' }}</span>{% endblock %}
{% block content %}
  <p class="label">{{ hook }}</p>
  <h1 class="display q">{{ question | mark }}</h1>
  <div class="opts">{% for o in options %}<div><span>{{ 'AB'[loop.index0] }}</span>{{ o }}</div>{% endfor %}</div>
  <p class="label cta">{{ cta }}</p>
{% endblock %}
