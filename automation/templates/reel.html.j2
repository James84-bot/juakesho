{#- Reel (9:16): the post told in beats. One short line at a time, full screen, over the real photo.
    Words slam in; the *marked* words land on the red marker; a progress bar counts down each beat.
    Fields: beats (3-6 lines, the script), kicker (series tag), plus the post's photo. Rendered by video.py. -#}
{% extends "base.html.j2" %}
{% set BT = namespace(t=0.0, starts=[], durs=[]) %}
{% for b in beats %}{% set d = beat_seconds(b) %}{% set _ = BT.starts.append(BT.t) %}{% set _ = BT.durs.append(d) %}{% set BT.t = BT.t + d %}{% endfor %}
{% block style %}
.has-photo { --ph: {{ H }}px; }
.photo { animation: kb {{ BT.t + 1 }}s linear both !important; }
@keyframes kb { from { scale: 1.02; } to { scale: 1.14; } }
.photo-fade { height: 100% !important; background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 88%, transparent) 0,
  color-mix(in srgb, var(--bg) 52%, transparent) 26%, color-mix(in srgb, var(--bg) 60%, transparent) 62%,
  color-mix(in srgb, var(--bg) 92%, transparent) 100%) !important; }
.top { top: 168px; }
.bars { position: absolute; left: var(--m); right: var(--m); top: 128px; display: flex; gap: 8px; z-index: 3; }
.bars i { flex: 1; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .26); overflow: hidden; }
.bars i b { display: block; height: 100%; background: var(--shuka-500); transform-origin: left; scale: 0 1; }
.live { display: inline-flex; align-items: center; gap: 12px; }
.live::before { content: ""; width: 16px; height: 16px; border-radius: 50%; background: var(--shuka-500);
  box-shadow: 0 0 0 0 rgba(223, 54, 54, .7); animation: live 1.2s ease-out infinite; }
@keyframes live { 0% { box-shadow: 0 0 0 0 rgba(223, 54, 54, .75); } 100% { box-shadow: 0 0 0 22px rgba(223, 54, 54, 0); } }
.top img { height: 34px; display: block; }
.stage { position: absolute; left: var(--m); right: 132px; top: 420px; bottom: 560px; display: grid; align-items: center; }
.beat { grid-area: 1 / 1; font-family: "Inter Tight", sans-serif; font-weight: 900; letter-spacing: -.03em; line-height: 1.02;
  color: #fff; text-shadow: 0 3px 28px rgba(0, 0, 0, .45); opacity: 0; }
.beat .t { display: inline-block; margin-right: .22em; }
.beat .m { background: var(--shuka-600); padding: 0 .1em; margin-right: .3em; border-radius: .05em; text-shadow: none; }
.foot, .layer { display: none; }
@keyframes show { 0% { opacity: 0; } 4% { opacity: 1; } 93% { opacity: 1; } 100% { opacity: 0; translate: 0 -40px; } }
@keyframes stay { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes slam { 0% { opacity: 0; scale: 1.45; translate: 0 .12em; } 100% { opacity: 1; scale: 1; translate: 0 0; } }
@keyframes fill { to { scale: 1 1; } }
{% for b in beats %}{% set s = BT.starts[loop.index0] %}{% set d = BT.durs[loop.index0] %}
.b{{ loop.index }} { font-size: {{ fitw(b, 860, 4, 132) }}px;
  animation: {{ 'stay .15s linear both' if loop.last else 'show ' ~ d ~ 's linear both' }}; animation-delay: {{ s }}s; }
.bars i:nth-child({{ loop.index }}) b { animation: fill {{ d }}s linear {{ s }}s both; }
{% endfor %}
.beat .t { animation: slam .34s cubic-bezier(.2, .9, .25, 1.15) both; }
{% endblock %}
{% block top %}<span class="tag live">{{ kicker }}</span><img src="{{ logo_on_dark }}" alt="Jua Kesho">{% endblock %}
{% block footer %}
  <div class="bars">{% for b in beats %}<i><b></b></i>{% endfor %}</div>
  <div class="stage">
    {% for b in beats %}{% set s = BT.starts[loop.index0] %}
    <div class="beat b{{ loop.index }}">{% for w, m in beat_tokens(b) %}<span class="t{{ ' m' if m }}" style="animation-delay: {{ '%.2f' % (s + 0.08 + loop.index0 * 0.07) }}s">{{ w }}</span>{% endfor %}</div>
    {% endfor %}
  </div>
{% endblock %}
