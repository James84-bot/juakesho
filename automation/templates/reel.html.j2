{#- Reel (9:16): the post told in beats. One short line at a time, full screen, over the real photo.
    The first line is on screen from frame 0; later lines' words land fast (no blank frames between lines);
    the *marked* words land on the red marker; a progress bar counts down each beat.
    Fields: beats (3-6 lines, the script), kicker (series tag), plus the post's photo. Rendered by video.py. -#}
{% extends "base.html.j2" %}
{% set BT = namespace(t=0.0, starts=[], durs=[]) %}
{% for b in beats %}{% set d = beat_seconds(b) %}{% set _ = BT.starts.append(BT.t) %}{% set _ = BT.durs.append(d) %}{% set BT.t = BT.t + d %}{% endfor %}
{% block style %}
.has-photo { --ph: {{ H }}px; }
.photo { animation: kb {{ BT.t + 1 }}s linear both !important; }
@keyframes kb { from { scale: 1.02; } to { scale: 1.14; } }
{% if shots and beats|length > 1 %}
/* a new shot on every line: the story's pictures take turns, one per line, and each line cuts to a different
   framing (wide, then closer, left, right) that drifts in, so the picture changes every ~2-3 seconds */
{% set FR = [(1.0, 0, 0), (1.07, -2, 1), (1.05, 2, -1), (1.09, 0, 2), (1.04, -2, -1), (1.08, 2, 1)] if card
            else [(1.04, 0, 0), (1.28, -6, 4), (1.18, 6, -3), (1.36, 0, 6), (1.12, -4, -4), (1.24, 5, 3)] %}
{% set DRIFT = 0.03 if card else 0.05 %}
{% set T = BT.t + 1 %}
@keyframes cam {
{% for b in beats %}{% set i = loop.index0 %}{% set f = FR[i % (FR | length)] %}
{% set a = BT.starts[i] / T * 100 %}{% set e = (BT.starts[i + 1] if not loop.last else T) / T * 100 - 0.02 %}
  {{ '%.3f' % a }}% { scale: {{ f[0] }}; translate: {{ f[1] }}% {{ f[2] }}%; }
  {{ '%.3f' % e }}% { scale: {{ '%.2f' % (f[0] + DRIFT) }}; translate: {{ '%.1f' % (f[1] * 0.85) }}% {{ '%.1f' % (f[2] * 0.85) }}%; }
{% endfor %}
}
.shot .cam { animation: cam {{ T }}s linear both; }
{% for k in range(-1, shots | length) %}
@keyframes vis{{ k + 1 }} {
{% for b in beats %}{% set i = loop.index0 %}{% set on = 1 if seq[i] == k else 0 %}
{% set a = BT.starts[i] / T * 100 %}{% set e = (BT.starts[i + 1] if not loop.last else T) / T * 100 - 0.02 %}
  {{ '%.3f' % a }}% { opacity: {{ on }}; } {{ '%.3f' % e }}% { opacity: {{ on }}; }
{% endfor %}
}
{% if k >= 0 %}.sh{{ k }} { animation: vis{{ k + 1 }} {{ T }}s linear both; }{% else %}.footage-tag { animation: vis0 {{ T }}s linear both; }{% endif %}
{% endfor %}
{% endif %}
{% if broll %}
/* the moving footage shows through where no photo is drawn; it illustrates the subject, it is not the place */
.footage-tag { position: absolute; left: var(--m); top: 300px; z-index: 3; font: 700 24px/1 "Inter"; color: #fff;
  background: rgba(14, 12, 11, .62); padding: 8px 12px; border-radius: 4px; letter-spacing: .03em; opacity: 0; }
{% endif %}
{% if shots %}
/* the pictures are drawn here (not by the base layer) so every one of them can move and take its turn */
.photo, .photo-band { display: none !important; }
.photo-fade { z-index: 1; }
.shot { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
.shot .full { position: absolute; inset: 0; background-size: cover; background-position: center var(--sfy, 30%);
  filter: saturate(1.06) contrast(1.06) brightness(1.03); transform-origin: 50% var(--sfy, 30%); }
.shot .blur { position: absolute; inset: -80px; background-size: cover; background-position: center;
  filter: blur(30px) brightness(.5) saturate(1.1); }
.shot .box { position: absolute; left: 0; width: 100%; top: 300px; height: {{ [photo_band, 760] | min }}px; overflow: hidden;
  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 82%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0, #000 82%, transparent 100%); }
.shot .box img { width: 100%; height: 100%; object-fit: cover; object-position: center var(--sfy, 30%); display: block;
  transform-origin: 50% var(--sfy, 30%); }
{% if beats|length < 2 %}.shot .cam { animation: kb {{ BT.t + 1 }}s linear both; }{% endif %}
{% if not photo_band and not chart %}
/* a full-size picture stays in view: the lines sit in the lower third, like the big news pages, not over faces */
.stage { top: 860px !important; bottom: 330px !important; align-items: end !important; }
{% endif %}
{% endif %}
.photo-fade { height: 100% !important; background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 78%, transparent) 0,
  color-mix(in srgb, var(--bg) 18%, transparent) 16%, color-mix(in srgb, var(--bg) 30%, transparent) 40%,
  color-mix(in srgb, var(--bg) 42%, transparent) 62%, color-mix(in srgb, var(--bg) 90%, transparent) 100%) !important; }
.beat { text-shadow: 0 4px 30px rgba(0, 0, 0, .65), 0 1px 3px rgba(0, 0, 0, .5) !important; }
.top { top: 168px; }
.bars { position: absolute; left: var(--m); right: var(--m); top: 128px; display: flex; gap: 8px; z-index: 3; }
.bars i { flex: 1; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .26); overflow: hidden; }
.bars i b { display: block; height: 100%; background: var(--shuka-500); transform-origin: left; scale: 0 1; }
.live { display: inline-flex; align-items: center; gap: 12px; }
.live::before { content: ""; width: 16px; height: 16px; border-radius: 50%; background: var(--shuka-500);
  box-shadow: 0 0 0 0 rgba(223, 54, 54, .7); animation: live 1.2s ease-out infinite; }
@keyframes live { 0% { box-shadow: 0 0 0 0 rgba(223, 54, 54, .75); } 100% { box-shadow: 0 0 0 22px rgba(223, 54, 54, 0); } }
.top img { height: 34px; display: block; }
.ctx { position: absolute; left: var(--m); right: var(--m); top: 250px; z-index: 3; font: 800 26px/1 "Inter Tight";
  letter-spacing: .08em; text-transform: uppercase; color: rgba(255, 255, 255, .86); text-shadow: 0 2px 10px rgba(0, 0, 0, .5); }
.stage { position: absolute; left: var(--m); right: 132px; top: 420px; bottom: 560px; display: grid; align-items: center; z-index: 3; }
{% if photo_band %}
/* a small news photo sits sharp under the header; the lines run below it */
.canvas { --band-top: 300px; }
.photo-band { animation: kb {{ BT.t + 1 }}s linear both; }
.stage { top: {{ 300 + [photo_band, 760] | min + 40 }}px; bottom: 300px; }
{% endif %}
{% if shots and card %}
{% set CW = card_w %}{% set CH = card_h %}
/* news photos sit whole and sharp in a 4:3 card under the header, on a plain dark ground, edges on the text
   margin; the lines run below the picture, never over a face, and each picture carries its own credit */
.photo-fade { display: none !important; }
.shot { background: #0E0C0B; }
.shot .card { position: absolute; left: var(--m); top: 300px; width: {{ CW }}px; height: {{ CH }}px; overflow: hidden;
  border-radius: 14px; background: #1B1815; }
.shot .card img { width: 100%; height: 100%; object-fit: cover; object-position: center var(--sfy, 30%); display: block;
  transform-origin: 50% var(--sfy, 30%); filter: saturate(1.05) contrast(1.04); }
/* a small picture is shown whole, centred in the card, rather than blown up to fill it */
.shot .card.fit { background: transparent; border-radius: 0; }
.shot .card.fit img { position: absolute; border-radius: 14px; object-fit: fill; }
.shot .cr { position: absolute; right: var(--m); top: {{ 300 + CH + 16 }}px; font: 600 22px/1 "Inter"; letter-spacing: .02em;
  color: rgba(255, 255, 255, .5); }
.stage { top: {{ 300 + CH + 74 }}px !important; bottom: 300px !important; align-items: start !important; }
.beat { text-shadow: none !important; }
/* the wipe crosses the card only: it is revealed left to right, then cleared to the right (it never rests outside) */
.wipe { top: 300px !important; bottom: auto !important; left: var(--m) !important; width: {{ CW }}px !important;
  height: {{ CH }}px !important; border-radius: 14px; translate: 0 0 !important; clip-path: inset(0 100% 0 0); }
@keyframes wipec { 0% { clip-path: inset(0 100% 0 0); } 50% { clip-path: inset(0 0 0 0); } 100% { clip-path: inset(0 0 0 100%); } }
.wipe { animation-name: wipec !important; }
.footage-tag { top: 300px; }
{% endif %}
.beat { grid-area: 1 / 1; font-family: "Inter Tight", sans-serif; font-weight: 900; letter-spacing: -.03em; line-height: 1.02;
  color: #fff; text-shadow: 0 3px 28px rgba(0, 0, 0, .45); opacity: 0; }
.beat .t { display: inline-block; margin-right: .22em; }
.beat .m { background: var(--shuka-600); padding: 0 .1em; margin-right: .3em; border-radius: .05em; text-shadow: none; }
.beat .m.j { margin-right: 0; padding-right: .32em; }   /* the next word is in the same marker: no gap between them */
.foot, .layer { display: none; }
@keyframes show { 0% { opacity: 1; } 97% { opacity: 1; } 100% { opacity: 0; } }
@keyframes stay { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes slam { 0% { opacity: 0; scale: 1.25; translate: 0 .08em; } 100% { opacity: 1; scale: 1; translate: 0 0; } }
@keyframes fill { to { scale: 1 1; } }
{% if chart %}
/* the rise as bars: how many shillings more per litre, each fuel against the biggest rise */
.stage { bottom: {{ 900 if stake else 760 }}px; }
.cx { position: absolute; left: var(--m); right: var(--m); bottom: 190px; z-index: 3; display: grid; gap: 38px; }
.cx-r { display: grid; gap: 10px; opacity: 0; animation: stay .5s linear both; }
.cx-h { display: flex; justify-content: space-between; align-items: baseline; font: 900 40px/1 "Inter Tight"; color: #fff; letter-spacing: -.01em; }
.cx-h b { font-size: 52px; }
.cx-b { height: 26px; border-radius: 4px; background: #fff; scale: 0 1; transform-origin: left; animation: fill .9s cubic-bezier(.2,.8,.2,1) both; }
.cx-s { font: 800 34px/1.15 "Inter Tight"; color: #fff; background: rgba(0,0,0,.34); padding: 16px 20px; border-radius: 6px; opacity: 0; animation: stay .5s linear 2.4s both; }
.cx-n { font: 700 28px/1 "Inter Tight"; color: rgba(255,255,255,.88); letter-spacing: .02em; }
{% for r in chart %}.cx-r:nth-child({{ loop.index }}), .cx-r:nth-child({{ loop.index }}) .cx-b { animation-delay: {{ '%.2f' % (1.0 + loop.index0 * 0.35) }}s; }
{% endfor %}
{% endif %}
{% for b in beats %}{% set s = BT.starts[loop.index0] %}{% set d = BT.durs[loop.index0] %}
.b{{ loop.index }} { font-size: {{ fitw(b, 860, 4, 96 if photo_band else 100 if card else 132) }}px;
  animation: {{ 'stay .15s linear both' if loop.last else 'show ' ~ d ~ 's linear both' }}; animation-delay: {{ s }}s; }
.bars i:nth-child({{ loop.index }}) b { animation: fill {{ d }}s linear {{ s }}s both; }
{% endfor %}
.beat .t { animation: slam .22s cubic-bezier(.2, .9, .25, 1.1) both; }
/* between lines: a fast brand-red wipe crosses the frame, and the photo cuts to its next shot behind it */
.wipe { position: absolute; top: 0; bottom: 0; left: 0; width: 100%; z-index: 4; background: var(--shuka-600);
  translate: -101% 0; pointer-events: none; }
@keyframes wipe { 0% { translate: -101% 0; } 50% { translate: 0 0; } 100% { translate: 101% 0; } }
{% for b in beats %}{% if not loop.first %}.w{{ loop.index }} { animation: wipe .26s cubic-bezier(.6, 0, .4, 1) {{ '%.2f' % (BT.starts[loop.index0] - 0.13) }}s both; }
{% endif %}{% endfor %}
/* the first line is fully on screen from the first frame: it is the thumbnail and the reason to stay */
.b1, .b1 .t { animation: none !important; opacity: 1; }
.b1 { animation: {{ 'none' if beats|length == 1 else 'show ' ~ BT.durs[0] ~ 's linear both' }} !important; }
{% endblock %}
{% block top %}<span class="tag live">{{ kicker }}</span><img src="{{ logo_on_dark }}" alt="Kenya on Record">{% endblock %}
{% block footer %}
  {% if context_line %}<div class="ctx">{{ context_line }}</div>{% endif %}
  {% if broll %}<span class="footage-tag">{{ footage_label }}</span>{% endif %}
  {% for sh in shots %}<div class="shot sh{{ loop.index0 }}" style="--sfy: {{ sh.fy }}%">
    {% if card %}<div class="card{{ ' fit' if sh.fit }}"><img class="cam" src="{{ sh.uri }}" alt=""{% if sh.fit %} style="left: {{ sh.fit.x }}px; top: {{ sh.fit.y }}px; width: {{ sh.fit.w }}px; height: {{ sh.fit.h }}px"{% endif %}></div>{% if sh.credit %}<span class="cr">{{ sh.credit }}</span>{% endif %}
    {% elif photo_band %}<div class="blur" style="background-image: url('{{ sh.uri }}')"></div><div class="box"><img class="cam" src="{{ sh.uri }}" alt=""></div>
    {% else %}<div class="full cam" style="background-image: url('{{ sh.uri }}')"></div>{% endif %}
  </div>{% endfor %}
  <div class="bars">{% for b in beats %}<i><b></b></i>{% endfor %}</div>
  {% for b in beats %}{% if not loop.first %}<i class="wipe w{{ loop.index }}"></i>{% endif %}{% endfor %}
  <div class="stage">
    {% for b in beats %}{% set s = BT.starts[loop.index0] %}
    {% set first = loop.first %}<div class="beat b{{ loop.index }}">{% for w, m, j in beat_marks(b) %}{% set at = s + loop.index0 * 0.035 %}<span class="t{{ ' m' if m }}{{ ' j' if j }}" style="animation-delay: {{ '%.2f' % at }}s"{% if m and counts(w) and not first %} data-count data-t0="{{ '%.2f' % (at + 0.05) }}" data-t1="{{ '%.2f' % (at + 0.95) }}"{% endif %}>{{ w }}</span>{% endfor %}</div>
    {% endfor %}
  </div>
  {% if chart %}{% set top = chart | map(attribute='rise') | max %}
  <div class="cx">{% for r in chart %}
    <div class="cx-r"><div class="cx-h"><span>{{ r.label }}</span><b>+Sh{{ '%.2f' % r.rise }}</b></div>
      <div class="cx-b" style="width: {{ '%.1f' % (r.rise / top * 100) }}%"></div>
      <div class="cx-n">Sh{{ '%.2f' % r.old }} to Sh{{ '%.2f' % r.new }} a litre</div></div>{% endfor %}
  {% if stake %}<div class="cx-s">{{ stake }}</div>{% endif %}
  </div>{% endif %}
{% endblock %}
