{#- Reel (9:16): the post told in beats. One short line at a time, full screen, over real photos of the story.
    The first line is fully on screen from frame 0 (it is the thumbnail and the first second); each next line cuts
    in with a short rise, never through an empty frame. With more than one photo (extra_photos), each line gets the
    next photo, with its own credit. *Marked* words sit on the red marker; a progress bar counts down each beat.
    Fields: beats (3-6 lines, the script), kicker (series tag), plus the post's photos. Rendered by video.py. -#}
{% extends "base.html.j2" %}
{% set BT = namespace(t=0.0, starts=[], durs=[]) %}
{% set PH = [(photo_uri, photo_credit)] + (extra_photos | default([])) if photo_uri is defined else [] %}
{% for b in beats %}{% set d = beat_seconds(b) %}{% set _ = BT.starts.append(BT.t) %}{% set _ = BT.durs.append(d) %}{% set BT.t = BT.t + d %}{% endfor %}
{% block style %}
.has-photo { --ph: {{ H }}px; }
.photo { animation: kb {{ BT.t + 1 }}s linear both !important; }
@keyframes kb { from { scale: 1.02; } to { scale: 1.14; } }
.photo-fade { height: 100% !important; background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 78%, transparent) 0,
  color-mix(in srgb, var(--bg) 18%, transparent) 16%, color-mix(in srgb, var(--bg) 30%, transparent) 40%,
  color-mix(in srgb, var(--bg) 42%, transparent) 62%, color-mix(in srgb, var(--bg) 90%, transparent) 100%) !important; }
.beat { text-shadow: 0 4px 30px rgba(0, 0, 0, .65), 0 1px 3px rgba(0, 0, 0, .5) !important; }
.photo-fade { z-index: 1; }
.xphoto { position: absolute; inset: 0; background-size: cover; background-position: center 30%; opacity: 0; z-index: 0;
  filter: saturate(1.06) contrast(1.06) brightness(1.03); }
.canvas > .credit { display: none; }
.xcredit { position: absolute; right: 26px; top: 150px; white-space: nowrap; writing-mode: vertical-rl; rotate: 180deg;
  font: 500 15px "Inter"; color: #fff; letter-spacing: .02em; text-shadow: 0 1px 3px rgba(0, 0, 0, .7); opacity: 0; z-index: 4; }
@keyframes win { from, to { opacity: 1; } }
@keyframes push { from { scale: 1.04; } to { scale: 1.12; } }
.top { top: 168px; }
.bars { position: absolute; left: var(--m); right: var(--m); top: 128px; display: flex; gap: 8px; z-index: 3; }
.bars i { flex: 1; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .26); overflow: hidden; }
.bars i b { display: block; height: 100%; background: var(--shuka-500); transform-origin: left; scale: 0 1; }
.live { display: inline-flex; align-items: center; gap: 12px; }
.live::before { content: ""; width: 16px; height: 16px; border-radius: 50%; background: var(--shuka-500);
  box-shadow: 0 0 0 0 rgba(223, 54, 54, .7); animation: live 1.2s ease-out infinite; }
@keyframes live { 0% { box-shadow: 0 0 0 0 rgba(223, 54, 54, .75); } 100% { box-shadow: 0 0 0 22px rgba(223, 54, 54, 0); } }
.top img { height: 34px; display: block; }
.ctx { position: absolute; left: var(--m); right: var(--m); top: 250px; z-index: 3; font: 800 26px/1 "Inter Tight";
  letter-spacing: .08em; text-transform: uppercase; color: rgba(255, 255, 255, .86); text-shadow: 0 2px 10px rgba(0, 0, 0, .5); }
.stage { position: absolute; left: var(--m); right: 132px; top: 420px; bottom: 560px; display: grid; align-items: center; z-index: 3; }
.beat { grid-area: 1 / 1; font-family: "Inter Tight", sans-serif; font-weight: 900; letter-spacing: -.03em; line-height: 1.02;
  color: #fff; text-shadow: 0 3px 28px rgba(0, 0, 0, .45); opacity: 0; }
.beat .t { display: inline-block; margin-right: .22em; }
.beat .m { background: var(--shuka-600); padding: 0 .1em; margin-right: .3em; border-radius: .05em; text-shadow: none; }
.foot, .layer { display: none; }
@keyframes rise { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
@keyframes fill { to { scale: 1 1; } }
{#- each beat is visible only inside its own window (no fill), so two lines never share the screen and none is
    ever missing; the last one holds to the end -#}
{% for b in beats %}{% set s = BT.starts[loop.index0] %}{% set d = BT.durs[loop.index0] + (3 if loop.last else 0) %}
.b{{ loop.index }} { font-size: {{ fitw(b, 860, 4, 132) }}px; animation: win {{ d }}s linear {{ s }}s; }
{% if not loop.first %}.b{{ loop.index }} .line { animation: rise .2s cubic-bezier(.2, .8, .2, 1) {{ s }}s both; }{% endif %}
.bars i:nth-child({{ loop.index }}) b { animation: fill {{ BT.durs[loop.index0] }}s linear {{ s }}s both; }
{% if PH %}.p{{ loop.index }} { animation: win {{ d }}s linear {{ s }}s, push {{ d }}s linear {{ s }}s both; }
.c{{ loop.index }} { animation: win {{ d }}s linear {{ s }}s; }{% endif %}
{% endfor %}
{% endblock %}
{% block top %}<span class="tag live">{{ kicker }}</span><img src="{{ logo_on_dark }}" alt="Kenyans Are Asking">{% endblock %}
{% block footer %}
  {% if PH|length > 1 %}{% for b in beats %}{% set ph = PH[loop.index0 % PH|length] %}
  <div class="xphoto p{{ loop.index }}" style="background-image: url('{{ ph[0] }}')"></div>{% endfor %}{% endif %}
  {% for b in beats %}{% set ph = PH[loop.index0 % PH|length] if PH else None %}{% if ph and ph[1] %}
  <span class="xcredit c{{ loop.index }}">{{ ph[1] }}</span>{% endif %}{% endfor %}
  {% if context_line %}<div class="ctx">{{ context_line }}</div>{% endif %}
  <div class="bars">{% for b in beats %}<i><b></b></i>{% endfor %}</div>
  <div class="stage">
    {% for b in beats %}{% set s = BT.starts[loop.index0] %}
    <div class="beat b{{ loop.index }}"><div class="line">{% for w, m in beat_tokens(b) %}<span class="t{{ ' m' if m }}">{{ w }}</span>{% endfor %}</div></div>
    {% endfor %}
  </div>
{% endblock %}
