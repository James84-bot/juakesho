{#- Follow the Money — one public-money number, what it means, how to check it yourself.
    Fields: hook, number, unit, what, why, check -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 540px; }
.num { font-size: {{ fit(number, 936, 230 if photo_uri is not defined else 190) }}px; letter-spacing: -.045em; line-height: .9;
  color: var(--accent); white-space: nowrap; font-weight: 900; font-variant-numeric: tabular-nums; }
.unit { margin-top: 14px; font: 800 34px/1.2 "Inter Tight"; letter-spacing: -.01em; color: var(--fg); }
.what { margin-top: 30px; }
.check { margin-top: 26px; font-size: 26px; }
.check b { color: var(--fg); font-weight: 700; }
{% endblock %}
{% block top %}<span class="tag tag--green">Follow the Money</span><span class="meta">{{ person_role if person_shown is defined and person_role is defined else 'Public money' }}</span>{% endblock %}
{% block content %}
  <p class="label">{{ hook }}</p>
  <p class="display num" data-count>{{ number }}</p>
  <p class="unit">{{ unit }}</p>
  <p class="lead what">{{ what | nb }}</p>
  <div class="gap"></div>
  <p class="label">Why you should care</p>
  <p class="strong">{{ why | nb }}</p>
  <p class="body check"><b>Check it yourself:</b> {{ check | nb }}</p>
{% endblock %}
