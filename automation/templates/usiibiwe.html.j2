{#- Usiibiwe! — scam awareness. Fields: title, sender, sms, tips (list), expr -#}
{% extends "base.html.j2" %}
{% block style %}
.series { position: absolute; top: 84px; left: 84px; background: var(--jua); color: var(--usiku); font-size: 26px; }
.mascot { position: absolute; top: 40px; right: 40px; width: 220px; height: 220px; }
.title { position: absolute; left: 84px; top: 200px; width: 720px; font-size: {{ fitw(title, 720, 2, 84) }}px; }
.phone { position: absolute; left: 110px; top: 480px; width: 640px; padding: 30px 34px 34px; background: var(--maziwa); color: var(--usiku);
  border-radius: 34px 34px 34px 6px; transform: rotate(-2deg); box-shadow: 14px 16px 0 var(--usiku); }
.phone small { display: block; font-size: 24px; font-weight: 700; opacity: .6; margin-bottom: 10px; }
.phone p { font-size: 32px; line-height: 1.3; }
.stamp { position: absolute; left: 640px; top: 430px; padding: 8px 26px; border: 7px solid var(--jua); color: var(--jua);
  border-radius: 12px; font-size: 66px; transform: rotate(12deg); background: var(--shuka); }
.tips { position: absolute; left: 84px; right: 84px; top: 830px; list-style: none; display: grid; gap: 18px; }
.tips li { display: grid; grid-template-columns: 50px 1fr; gap: 18px; font-size: 32px; font-weight: 700; line-height: 1.25; }
.tick { width: 46px; height: 46px; }
{% endblock %}
{% block art %}
  {{ confetti(W, H, seed, n=5, avoid=[(40, 180, 1000, 1030)], palette=[C.jua, C.waridi, C.udongo], rmax=30) }}
  {{ blob(960, 560, 150, C.udongo, seed + 3, wobble=0.25) }}
{% endblock %}
{% block content %}
  <span class="pill series">&#9888; Usiibiwe!</span>
  <svg class="mascot" viewBox="0 0 200 200">{{ mascot(expr) }}</svg>
  <h1 class="display title">{{ title }}</h1>
  <div class="phone"><small>From: {{ sender }}</small><p>{{ sms }}</p></div>
  <p class="display stamp">SCAM</p>
  <ul class="tips">
    {% for t in tips %}
    <li><svg class="tick" viewBox="0 0 46 46"><path d="{{ 'M4,23 C12,20 16,28 18,34 C24,20 32,10 42,6' }}" fill="none" stroke="{{ C.jua }}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ t | nb }}</span></li>
    {% endfor %}
  </ul>
{% endblock %}
