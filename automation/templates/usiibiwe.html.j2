{#- Usiibiwe! — scam awareness. Fields: title, sender, sms, tips (list), expr -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 480px; }
.title { font-size: {{ fitw(title, 936, 3, 112 if photo_uri is not defined else 84) }}px; }
.msg { position: relative; margin-top: 44px; padding: 28px 32px 30px; border-radius: 18px 18px 18px 4px; background: var(--ink-50); color: var(--ink-900); }
.msg small { display: block; font: 600 22px/1.2 "Inter"; color: var(--ink-500); margin-bottom: 10px; }
.msg p { font: 500 30px/1.36 "Inter"; }
.msg b { position: absolute; right: 24px; top: -22px; padding: 10px 16px 9px; border-radius: 4px; background: var(--shuka-600); color: #fff;
  font: 900 24px/1 "Inter Tight"; letter-spacing: .1em; }
.rows .n { color: var(--ink-50); }
{% endblock %}
{% block top %}<span class="tag">Scam alert</span><span class="meta">Usiibiwe</span>{% endblock %}
{% block content %}
  <h1 class="display title">{{ title | mark }}</h1>
  <div class="msg"><small>From: {{ sender }}</small><p>{{ sms }}</p><b>SCAM</b></div>
  <div class="gap"></div>
  <p class="label">Stay safe</p>
  <div class="rows">
    {% for t in tips %}<div class="row"><span class="n"></span><span>{{ t | nb }}</span></div>{% endfor %}
  </div>
{% endblock %}
