{#- Still in 2026? — roast an outdated way of doing things (never a person), then show the upgrade.
    Fields: industry, thing, old, new, cta -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 560px; }
.thing { font-size: {{ fitw(thing, 936, 4, 116 if photo_uri is not defined else 80) }}px; }
.cmp { display: grid; gap: 0; }
.cmp > div { padding: 26px 0; border-top: 2px solid var(--line); }
.cmp > div:last-child { border-bottom: 2px solid var(--line); }
.old p { text-decoration: line-through; text-decoration-color: var(--shuka-500); text-decoration-thickness: 3px; color: var(--muted); }
.old .label { color: var(--muted); }
.cta { margin-top: 30px; }
{% endblock %}
{% block top %}<span class="tag tag--red">Still in 2026?</span><span class="meta">{{ industry }}</span>{% endblock %}
{% block content %}
  <p class="label">It's 2026 and we still&hellip;</p>
  <h1 class="display thing">{{ thing | mark }}</h1>
  <div class="gap"></div>
  <div class="cmp">
    <div class="old"><p class="label">The old way</p><p class="body">{{ old | nb }}</p></div>
    <div class="new"><p class="label">The Kesho way</p><p class="strong">{{ new | nb }}</p></div>
  </div>
  <p class="strong cta">{{ cta }}</p>
{% endblock %}
