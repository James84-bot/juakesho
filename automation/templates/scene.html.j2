{#- Mtaa Mode scene: our cast in a real place, animated. Fields: title, place, cast, lines [{who, text, do, face, react}].
    The timeline (m.scene) comes from mtaa.scene_timeline, the place from mtaa_art, the cast's looks from mtaa.LOOKS.
    A still frame (the feed picture, the Reel's cover) is the hook line, fully said. -#}
{% extends "mtaa_base.html.j2" %}
{% block style %}
#world { position: absolute; inset: 0; transform-origin: 0 0; }
#world svg { position: absolute; inset: 0; }
.brandbar { z-index: 5; }
.title { position: absolute; left: 0; right: 0; top: 222px; display: flex; flex-direction: column; align-items: center; gap: 10px; z-index: 5; }
.title b { padding: 14px 26px 13px; border-radius: 999px; background: rgba(14, 14, 18, .82); color: var(--lime);
  font: 800 30px/1.1 "Inter Tight"; max-width: 900px; text-align: center; }
.title i { font: 600 21px/1 "Inter"; font-style: normal; color: #fff; padding: 7px 14px; border-radius: 999px; background: rgba(14, 14, 18, .55); }
.bub { position: absolute; left: 0; top: 0; max-width: 700px; padding: 18px 30px 22px; border-radius: 34px; background: #fff;
  color: #141418; box-shadow: 0 10px 30px rgba(0, 0, 0, .28); display: none; z-index: 4; }
.bub .who { font: 800 22px/1 "Inter Tight"; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 8px; }
.bub .say { font: 700 42px/1.2 "Inter"; }
.bub .say span { opacity: 0; }
.bub::after { content: ""; position: absolute; left: var(--tail, 50%); bottom: -22px; margin-left: -18px; border: 18px solid transparent;
  border-top: 26px solid #fff; border-bottom: 0; }
{% endblock %}
{% block under %}
  <div id="world"><svg viewBox="0 0 1080 1920" width="1080" height="1920" id="stage"><g id="bg">{{ m.backdrop }}</g><rect width="1080" height="1920" fill="#0E0E12" opacity=".14"/><g id="cast"></g></svg></div>
{% endblock %}
{% block content %}
  <div class="title"><b>{{ title }}</b><i>Animated skit · characters are fictional</i></div>
  {% for l in m.scene.lines %}
  <div class="bub" id="b{{ loop.index0 }}"><div class="who" style="color: {{ m.colors[l.who] }}">{{ m.names[l.who] }}</div>
    <div class="say">{% for w in l.text.split() %}<span>{{ w }}</span> {% endfor %}</div></div>
  {% endfor %}
{% endblock %}
{% block script %}
{% include "mtaa_rig.js" %}

  const SCENE = {{ m.scene | tojson }};
  const LOOKS = {{ m.looks | tojson }};
  const castLayer = document.getElementById('cast');
  const cast = SCENE.cast.map((c, i) => ({ ...c, g: drawCharacter(castLayer, { ...LOOKS[c.key], key: c.key }) }));
  const byKey = Object.fromEntries(cast.map((c) => [c.key, c]));
  const world = document.getElementById('world');
  const drift = document.getElementById('drift');
  const bubs = SCENE.lines.map((l, i) => document.getElementById('b' + i));

  const lineAt = (t) => { let cur = -1; SCENE.lines.forEach((l, i) => { if (t >= l.start) cur = i; }); return cur; };
  const faceOf = (ch, t, li) => {
    const l = SCENE.lines[li];
    if (l && l.who !== ch.key && l.react && t < l.end + 0.4) return l.react;
    let f = 'neutral';
    SCENE.lines.forEach((x) => { if (x.who === ch.key && t >= x.start) f = x.face || 'neutral'; });
    return f;
  };
  const camera = (t, li) => {
    // a slow push in; on the punchline, a cut in close on whoever says it
    let s = 1 + 0.05 * Math.min(1, t / SCENE.end), fx = 540, fy = 1180;
    const p = SCENE.punch;
    if (p && t >= p.at) {
      const who = byKey[p.who];
      s = 1.24; fx = Math.min(1000, Math.max(80, who.x)); fy = who.seated ? 1150 : 1080;
    }
    return { s, fx, fy };
  };

  ticks.push((t) => {
    t = Math.max(0, Math.min(t, SCENE.end - 0.001));
    const li = lineAt(t);
    const speaker = li >= 0 && t < SCENE.lines[li].end + 0.5 ? SCENE.lines[li].who : null;
    const states = cast.map((ch) => poseAt(ch, t, SCENE));
    cast.forEach((ch, i) => {
      const st = states[i];
      // facing: listeners look at the speaker; the speaker at the nearest one on screen; walkers where they go
      let look = ch.facing0;
      const vis = cast.filter((o, j) => o !== ch && states[j].visible);
      if (st.walking) look = st.dir > 0 ? -1 : 1;
      else if (speaker && speaker !== ch.key && byKey[speaker] && states[cast.indexOf(byKey[speaker])].visible) look = byKey[speaker].x > st.x ? 1 : -1;
      else if (vis.length) { const n = vis.reduce((a, b) => Math.abs(b.x - st.x) < Math.abs(a.x - st.x) ? b : a); look = n.x > st.x ? 1 : -1; }
      const l = SCENE.lines.find((x) => x.who === ch.key && t >= x.start && t < x.talk_end);
      const talk = l ? ['talk1', 'talk2', 'talk3', 'talk2', 'talk1', 'neutral'][Math.floor((t - l.start) * 11 + ch.seed) % 6] : null;
      const blink = ((t + ch.seed * 0.71) % (2.9 + (ch.seed % 4) * 0.35)) < 0.12;
      applyPose(ch, st, look, ch.scale, SCENE.floor, faceOf(ch, t, li), talk, blink);
    });
    if (drift) drift.setAttribute('transform', `translate(${(-(t * 260) % 2400).toFixed(1)} 0)`);
    const cam = camera(t, li);
    world.style.transform = `translate(${cam.fx}px, ${cam.fy}px) scale(${cam.s}) translate(${-cam.fx}px, ${-cam.fy}px)`;
    // the line being said, in a bubble over the speaker's head; its words appear as they are said
    bubs.forEach((b, i) => {
      const l = SCENE.lines[i];
      const on = i === li && t < l.end + 0.5;
      b.style.display = on ? 'block' : 'none';
      if (!on) return;
      const words = [...b.querySelectorAll('.say span')];
      words.forEach((w, k) => { w.style.opacity = t >= l.start + (l.talk_end - l.start) * k / words.length ? 1 : 0; });
      const ch = byKey[l.who], st = states[cast.indexOf(ch)];
      const headTop = SCENE.floor + (ch.seated ? 104 : 0) * ch.scale - 690 * ch.scale;
      const X = cam.fx + (st.x - cam.fx) * cam.s, Y = cam.fy + (headTop - cam.fy) * cam.s;
      const box = b.getBoundingClientRect(), w = Math.ceil(box.width), h = Math.ceil(box.height);
      const left = Math.max(40, Math.min(1040 - w, X - w / 2));
      const top = Math.max(350, Y - h - 30);   // under the title
      b.style.left = left + 'px'; b.style.top = top + 'px';
      b.style.setProperty('--tail', Math.max(40, Math.min(w - 40, X - left)) + 'px');
    });
  });
  window.__fit = () => { {% if not motion %}ticks.forEach((f) => f({{ m.still_t }}));{% endif %} return 1; };
{% endblock %}
