{#- Set It Straight — answer misinformation and put-downs of Kenya/Africa with sourced facts.
    Target the claim, never the person: quote it exactly, credit where it came from, then the truth.
    Fields: claim, who, verdict (false|misleading|missing_context), truth, proof (2-3), pride,
            claim_source (where the claim was said), source (where the facts are verified) -#}
{% extends "base.html.j2" %}
{% set stamp = {"false": ("FALSE", C.shuka, "#fff"), "misleading": ("MISLEADING", C.jua, C.usiku),
                "missing_context": ("MISSING CONTEXT", C.pwani, C.usiku)}[verdict] %}
{% block style %}
.series { position: absolute; top: 84px; left: 84px; background: var(--shuka); color: #fff; }
.col { position: absolute; left: 70px; right: 70px; top: 170px; display: flex; flex-direction: column; gap: 26px; }
.said { font-size: 54px; color: var(--jua); transform: rotate(-2deg); margin-left: 14px; }
.claim { position: relative; padding: 42px 40px 26px; }
.claim q { display: block; font-size: {{ 34 if claim | length < 80 else 30 }}px; font-weight: 700; line-height: 1.26; font-style: italic;
  text-decoration: line-through; text-decoration-color: rgba(212, 48, 31, .85); text-decoration-thickness: 3px; }
.claim q::before { content: "\201C"; } .claim q::after { content: "\201D"; }
.claim .who { display: block; margin-top: 12px; font: 700 20px "Unbounded"; letter-spacing: .02em; opacity: .8; }
.stamp { position: absolute; right: 22px; top: -30px; padding: 10px 20px; border-radius: 12px; border: 4px solid var(--usiku);
  font: 800 30px "Unbounded"; letter-spacing: .02em; box-shadow: 6px 7px 0 var(--usiku); transform: rotate(6deg);
  background: {{ stamp[1] }}; color: {{ stamp[2] }}; }
.truth { font-size: {{ fitw(truth, 912, 3, 70) }}px; color: #fff; margin: 8px 14px 0; text-shadow: 0 0 40px rgba(255, 255, 255, .25); }
.truth-lead { font-size: 46px; color: var(--maziwa); margin: 0 14px -18px; text-shadow: 0 2px 12px rgba(10, 5, 25, .45); }
.proof { padding: 28px 36px; display: grid; gap: 14px; }
.proof div { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; font-size: 28px; font-weight: 600; line-height: 1.28; }
.proof svg { width: 36px; height: 36px; margin-top: 2px; }
.pride { position: absolute; left: 84px; right: 84px; top: 1118px; font-size: 48px; color: var(--jua); transform: rotate(-2deg); }
{% endblock %}
{% block backdrop %}{{ aurora(W, H, seed, colors=[C.shuka, C.jacaranda, C.chai, C.jua]) }}{% endblock %}
{% block art %}{% endblock %}
{% block content %}
  <span class="pill series">Set It Straight</span>
  <div class="col">
    <p class="hook said">they said&hellip;</p>
    <div class="glass claim"><q>{{ claim | nb }}</q><span class="who">{{ who }}</span>
      <span class="stamp">{{ stamp[0] }}</span></div>
    <p class="hook truth-lead">the truth:</p>
    <h1 class="display truth">{{ truth }}</h1>
    <div class="glass glass--light proof">
      {% for f in proof %}<div><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" fill="{{ C.chai }}"/><path d="M11,21 L17,27 L29,14" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ f | nb }}</span></div>{% endfor %}
    </div>
  </div>
  <p class="hook pride">{{ pride }}</p>
{% endblock %}
