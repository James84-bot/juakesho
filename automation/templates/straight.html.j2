{#- Set It Straight — answer misinformation and put-downs of Kenya/Africa with sourced facts.
    Quote the claim exactly, name who said it (public figures on the record), then the facts.
    Fields: claim, who, verdict (false|misleading|missing_context), truth, proof (2-3), pride,
            claim_source (where the claim was said), source (where the facts are verified) -#}
{% extends "base.html.j2" %}
{% set V = {"false": ("False", "var(--shuka-600)", "#fff"), "misleading": ("Misleading", "var(--shuka-200)", "var(--ink-950)"),
            "missing_context": ("Missing context", "var(--ink-50)", "var(--ink-950)")}[verdict] %}
{% block style %}
.has-photo { --ph: 560px; }
.claim { font: 600 {{ 36 if claim | length < 90 else 32 }}px/1.3 "Inter"; color: var(--soft); }
.claim q::before { content: "\201C"; } .claim q::after { content: "\201D"; }
.who { display: flex; align-items: center; gap: 18px; margin-top: 18px; font: 700 22px/1.2 "Inter Tight"; letter-spacing: .06em;
  text-transform: uppercase; color: var(--muted); }
.who b { padding: 10px 16px 9px; border-radius: 4px; background: {{ V[1] }}; color: {{ V[2] }}; font: 900 24px/1 "Inter Tight"; letter-spacing: .1em; }
.truth { font-size: {{ fitw(truth, 936, 4, 96 if photo_uri is not defined else 68) }}px; }
.rows .row { font-size: 27px; padding: 18px 0; }
.rows .n { color: var(--chai-300); }
.pride { margin-top: 24px; }
{% endblock %}
{% block top %}<span class="tag tag--red">Set It Straight</span><span class="meta">{{ person_role if person_shown is defined and person_role is defined else 'Fact check' }}</span>{% endblock %}
{% block content %}
  <p class="label" style="color: var(--muted)">The claim</p>
  <p class="claim"><q>{{ claim | nb }}</q></p>
  <p class="who"><b>{{ V[0] }}</b><span>{{ who }}</span></p>
  <div class="rule"></div>
  <p class="label">The facts</p>
  <h1 class="display truth">{{ truth | mark }}</h1>
  <div class="gap"></div>
  <div class="rows">
    {% for f in proof %}<div class="row"><span class="n"></span><span>{{ f | nb }}</span></div>{% endfor %}
  </div>
  <p class="strong pride">{{ pride }}</p>
{% endblock %}
