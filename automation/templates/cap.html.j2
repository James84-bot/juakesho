{#- Cap or No Cap? — a popular claim, a verdict, the real story.
    Fields: claim, verdict (cap | nocap | kinda), real -#}
{% extends "base.html.j2" %}
{% set V = {'cap': ('Cap', 'var(--shuka-600)', '#fff', 'False'), 'nocap': ('No cap', 'var(--chai-600)', '#fff', 'True'),
            'kinda': ('Kinda', 'var(--ink-50)', 'var(--ink-950)', 'Partly true')}[verdict] %}
{% block style %}
.has-photo { --ph: 560px; }
.claim { font-size: {{ fitw('“' ~ claim ~ '”', 936, 4, 104 if photo_uri is not defined else 72) }}px; }
.verdict { display: flex; align-items: center; gap: 22px; margin-top: 40px; }
.verdict b { padding: 14px 24px 12px; border-radius: 4px; background: {{ V[1] }}; color: {{ V[2] }};
  font: 900 64px/1 "Inter Tight"; letter-spacing: -.02em; text-transform: uppercase; }
.verdict span { font: 700 24px/1.2 "Inter Tight"; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
{% endblock %}
{% block top %}<span class="tag">Cap or No Cap?</span><span class="meta">{{ person_role if person_shown is defined and person_role is defined else 'Fact check' }}</span>{% endblock %}
{% block content %}
  <p class="label">They keep saying</p>
  <h1 class="display claim">&ldquo;{{ claim | mark }}&rdquo;</h1>
  <div class="verdict"><b>{{ V[0] }}</b><span>Verdict: {{ V[3] }}</span></div>
  <div class="gap"></div>
  <p class="label">Real talk</p>
  <p class="lead">{{ real | nb }}</p>
{% endblock %}
