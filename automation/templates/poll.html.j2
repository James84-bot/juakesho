{#- Story poll (1080x1920). Fields: question, options (2), cta -#}
{% extends "base.html.j2" %}
{% block style %}
.series { position: absolute; top: 200px; left: 84px; background: var(--jua); color: var(--usiku); font-size: 28px; }
.q { position: absolute; left: 84px; right: 84px; top: 340px; font-size: {{ fitw(question, 912, 2, 120) }}px; }
.opts { position: absolute; left: 84px; right: 84px; top: 720px; display: grid; gap: 30px; }
.opts span { padding: 40px 50px; font-size: 56px; color: var(--usiku); }
.cta { position: absolute; left: 84px; top: 1080px; font-size: 64px; color: var(--jua); transform: rotate(-4deg); }
.mascot { position: absolute; right: 30px; bottom: 170px; width: 460px; height: 460px; }
{% endblock %}
{% block art %}
  {{ confetti(W, H, seed, n=12, avoid=[(40, 170, 1000, 1200)], rmax=44) }}
{% endblock %}
{% block content %}
  <span class="pill series">Jua Asks</span>
  <h1 class="display q">{{ question }}</h1>
  <div class="opts">{% set oc = [C.jua, C.pwani, C.waridi] %}{% for o in options %}<span class="display" style="background: {{ oc[loop.index0] }}; border-radius: {{ radius(seed + loop.index) }}">{{ o }}</span>{% endfor %}</div>
  <p class="hand cta">{{ cta }}</p>
  <svg class="mascot" viewBox="0 0 200 200">{{ mascot('thinking') }}</svg>
{% endblock %}
