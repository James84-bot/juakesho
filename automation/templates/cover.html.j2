{#- Carousel cover. Fields: series, lines (list), highlight (index), kicker, expr -#}
{% extends "base.html.j2" %}
{% block style %}
.has-photo { --ph: 760px; }
.lines span { display: block; font-size: {{ fit(lines | join('\n'), 936, 150 if photo_uri is not defined else 108) }}px; }
.lines .hl { color: var(--accent); }
.kicker { margin-top: 40px; font: 800 26px/1.2 "Inter Tight"; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.kicker b { color: var(--accent); }
{% endblock %}
{% block top %}<span class="tag">{{ series }}</span><span class="meta">Swipe &rarr;</span>{% endblock %}
{% block content %}
  <div class="gap"></div>
  <h1 class="display lines">{% for l in lines %}<span class="{{ 'hl' if loop.index0 == highlight else '' }}">{{ l }}</span>{% endfor %}</h1>
  <p class="kicker">{{ kicker }}</p>
{% endblock %}
