{#- Shared frame for every Jua Kesho design.
    Child templates fill: art (SVG shapes behind), content (HTML), and set W/H. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
{{ font_faces }}
:root {
  {% for k, v in colors.items() %}--{{ k }}: {{ v }};
  {% endfor %}
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { background: #777; }
.canvas {
  position: relative; overflow: hidden;
  width: {{ W }}px; height: {{ H }}px;
  background: {{ bg }}; color: {{ ink }};
  font-family: "Figtree", system-ui, sans-serif;
}
.backdrop, .art, .grain { position: absolute; inset: 0; width: 100%; height: 100%; }
.backdrop { overflow: visible; }
/* Precomputed noise tile (render.py): same print-grain look, a fraction of the cost of a live filter */
.grain { background: url("{{ grain_uri }}"); background-size: 256px 256px; mix-blend-mode: multiply; opacity: .16; pointer-events: none; }
.layer { position: absolute; inset: 0; padding: {{ pad | default(84) }}px; }
.display { font-family: "Unbounded", sans-serif; font-weight: 800; letter-spacing: -.03em; line-height: .98; }
.hand { font-family: "Caveat", cursive; font-weight: 700; line-height: 1; }
.body { font-size: 34px; line-height: 1.32; font-weight: 500; }
.pill {
  display: inline-block; padding: 12px 24px; border-radius: 999px;
  font-family: "Unbounded", sans-serif; font-weight: 700; font-size: 22px; letter-spacing: .02em;
}
.foot {
  position: absolute; left: {{ pad | default(84) }}px; right: {{ pad | default(84) }}px; bottom: 60px;
  display: flex; justify-content: space-between; align-items: center;
  font-family: "Unbounded", sans-serif; font-weight: 700; font-size: 22px;
}
.foot img { height: 40px; }
/* Glass mode: frosted cards over aurora colour */
.glass {
  background: rgba(255, 255, 255, .13);
  -webkit-backdrop-filter: blur(26px) saturate(160%); backdrop-filter: blur(26px) saturate(160%);
  border: 2px solid rgba(255, 255, 255, .38);
  box-shadow: 0 24px 60px rgba(10, 5, 25, .35), inset 0 1px 0 rgba(255, 255, 255, .45);
  border-radius: 36px; color: #fff;
}
.glass--light { background: rgba(255, 255, 255, .55); color: var(--usiku); border-color: rgba(255, 255, 255, .8); }
.sticker {
  position: absolute; padding: 12px 22px; border-radius: 14px; border: 4px solid var(--usiku);
  font-family: "Unbounded", sans-serif; font-weight: 800; font-size: 26px; letter-spacing: .01em;
  box-shadow: 6px 7px 0 var(--usiku);
}
.hook { font-family: "Caveat", cursive; font-weight: 700; line-height: 1; }
{% block style %}{% endblock %}
{% if motion %}
/* ---- Motion: entrances are staggered by --i (set below); stepped frame by frame when exporting video ---- */
@keyframes enter { from { opacity: 0; translate: 0 46px; scale: .94; } to { opacity: 1; translate: 0 0; scale: 1; } }
@keyframes pop { 0% { opacity: 0; scale: .2; } 70% { opacity: 1; scale: 1.14; } 100% { opacity: 1; scale: 1; } }
@keyframes word { from { opacity: 0; translate: 0 .5em; } to { opacity: 1; translate: 0 0; } }
@keyframes bob { 0%, 100% { translate: 0 0; rotate: -3deg; } 50% { translate: 0 -14px; rotate: 3deg; } }
@keyframes tailin { from { opacity: 0; } to { opacity: 1; } }
@keyframes drift { 0%, 100% { translate: 0 0; } 50% { translate: 40px -30px; } }
/* The hook must be on screen from frame 0: nothing starts invisible for longer than ~0.1s */
.layer > * { animation: enter .6s cubic-bezier(.2, .9, .3, 1.25) both; animation-delay: calc(var(--i, 0) * .12s - .15s); }
.layer > .sticker, .layer > .stamp, .layer > .verdict { animation-name: pop; animation-duration: .55s; }
.layer > svg.mascot { animation: enter .6s cubic-bezier(.2, .9, .3, 1.25) both calc(var(--i, 0) * .12s - .15s),
                                 bob 2.6s ease-in-out calc(.6s + var(--i, 0) * .12s) infinite; }
.w { display: inline-block; animation: word .4s cubic-bezier(.2, .9, .3, 1.2) both; animation-delay: calc(var(--t0, .1s) + var(--w) * .06s); }
/* The whole colour cloud is one composited layer: blurred once, then only moved */
.backdrop { animation: drift 9s ease-in-out infinite; will-change: translate; }
{% endif %}
{% if reel %}
.reel { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: {{ bg }}; }
/* 9:16 safe zone: clear of the platform UI (top bar, right-hand buttons, bottom caption) */
.reel .canvas { position: absolute; left: 58px; top: 330px; overflow: visible; background: transparent; transform: scale(.84); transform-origin: 0 0; }
.reel .canvas > .grain { display: none; }
.reel > .grain { position: absolute; inset: 0; }
.reel .art, .reel .backdrop { overflow: visible; }
.reel-top { position: absolute; left: 0; right: 0; top: 215px; display: flex; justify-content: center; }
.reel-top img { height: 56px; }
{% endif %}
</style>
</head>
<body>
{% if reel %}<div class="reel" id="reel"><div class="reel-top"><img src="{{ logo_on_dark if dark else logo_on_light }}" alt=""></div>{% endif %}
<div class="canvas" id="canvas">
  <svg class="backdrop" viewBox="0 0 {{ W }} {{ H }}" preserveAspectRatio="none">{% block backdrop %}{% endblock %}</svg>
  <svg class="art" viewBox="0 0 {{ W }} {{ H }}" preserveAspectRatio="none">{{ GLOW }}{% block art %}{% endblock %}</svg>
  <div class="layer">{% block content %}{% endblock %}</div>
  {% block footer %}
  <div class="foot">
    <img src="{{ logo_on_dark if dark else logo_on_light }}" alt="">
    <span>{{ brand.handle }}</span>
  </div>
  {% endblock %}
  <div class="grain"></div>
</div>
{% if reel %}<div class="grain"></div></div>{% endif %}
{% if motion %}
<script>
  // Stagger order = document order of the layer's children. Headlines are split into words.
  document.querySelectorAll('.layer > *').forEach((el, i) => el.style.setProperty('--i', i));
  // Comic bubble tails live in the backdrop SVG: fade each in with its own bubble (same document order)
  const bubs = [...document.querySelectorAll('.layer > .bub')];
  document.querySelectorAll('path.tail').forEach((t, k) => {
    const i = bubs[k] ? parseFloat(bubs[k].style.getPropertyValue('--i')) || 0 : 0;
    t.style.animation = `tailin .3s ease-out ${i * 0.12 + 0.05}s both`;
  });
  document.querySelectorAll('.layer h1').forEach((h) => {
    const parent = h.closest('.layer > *');
    const t0 = Math.max(0, (parseFloat(getComputedStyle(parent).getPropertyValue('--i')) || 0) * 0.12 - 0.1);
    let n = 0;
    const walk = (node) => {
      [...node.childNodes].forEach((c) => {
        if (c.nodeType === 3) {
          const frag = document.createDocumentFragment();
          c.textContent.split(/(\s+)/).forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) { frag.append(part); return; }
            const s = document.createElement('span');
            s.className = 'w'; s.textContent = part;
            s.style.setProperty('--w', n++); s.style.setProperty('--t0', t0 + 's');
            frag.append(s);
          });
          c.replaceWith(frag);
        } else if (c.nodeType === 1 && !c.classList.contains('w')) walk(c);
      });
    };
    walk(h);
    h.style.animation = 'none';  // the words animate instead of the whole block
  });
  window.__motionEnd = () => {
    let end = 0;
    document.getAnimations().forEach((a) => {
      const t = a.effect.getComputedTiming();
      if (t.iterations !== Infinity) end = Math.max(end, t.endTime);
    });
    return end / 1000;
  };
  window.__seek = (t) => {
    document.getAnimations().forEach((a) => { a.pause(); a.currentTime = t * 1000; });
    document.querySelectorAll('svg').forEach((s) => { if (s.pauseAnimations) { s.pauseAnimations(); s.setCurrentTime(t); } });
  };
</script>
{% endif %}
</body>
</html>
