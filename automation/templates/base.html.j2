{#- Shared frame for every Jua Kesho design: the editorial system.
    Grid: 72px margins. Top bar (series tag + meta), content in one column, footer rule + logo.
    Type: Inter Tight (headlines, labels), Inter (text). Colour: ink carries the design, gold is the
    one highlight, red/green carry meaning. No decoration: a photo, type and rules do the work.
    Child templates fill: style, top (tag + meta), content. A real photo (photo_uri) sits behind the
    top of the canvas; templates set --ph (photo height) and the content starts over its faded edge. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
{{ font_faces }}
:root {
  {% for k, v in colors.items() %}--{{ k }}: {{ v }};
  {% endfor %}
  {% for fam, shades in palette.items() %}{% for s, v in shades.items() %}--{{ fam }}-{{ s }}: {{ v }}; {% endfor %}
  {% endfor %}
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { background: #777; }
{#- Theme per background: foreground, softer text, muted meta, rules, the accent for labels, the tag -#}
{% set T = {
  "usiku":  ("var(--ink-50)", "var(--ink-300)", "var(--ink-400)", "var(--ink-800)", "var(--shuka-400)", "var(--shuka-600)", "#fff"),
  "chai":   ("#fff", "var(--chai-50)", "var(--chai-100)", "rgba(255,255,255,.26)", "#fff", "var(--ink-950)", "#fff"),
  "shuka":  ("#fff", "var(--shuka-50)", "var(--shuka-100)", "rgba(255,255,255,.32)", "#fff", "var(--ink-950)", "#fff"),
  "jua":    ("#fff", "var(--shuka-50)", "var(--shuka-100)", "rgba(255,255,255,.32)", "#fff", "var(--ink-950)", "#fff"),
  "maziwa": ("var(--ink-900)", "var(--ink-700)", "var(--ink-500)", "var(--ink-200)", "var(--shuka-600)", "var(--shuka-600)", "#fff"),
}.get(bg_name, ("var(--ink-50)", "var(--ink-300)", "var(--ink-400)", "var(--ink-800)", "var(--shuka-400)", "var(--shuka-600)", "#fff")) %}
.canvas {
  position: relative; overflow: hidden;
  width: {{ W }}px; height: {{ H }}px;
  background: {{ bg }}; color: {{ T[0] }};
  --bg: {{ bg }}; --fg: {{ T[0] }}; --soft: {{ T[1] }}; --muted: {{ T[2] }}; --line: {{ T[3] }}; --accent: {{ T[4] }};
  --tag-bg: {{ T[5] }}; --tag-ink: {{ T[6] }};
  --mark-bg: {{ 'var(--ink-950)' if bg_name in ('shuka', 'jua', 'chai') else 'var(--shuka-600)' }}; --mark-ink: #fff;
  --m: {{ pad | default(72) }}px; --ph: 0px;
  font-family: "Inter", system-ui, sans-serif; font-feature-settings: "ss01" 0, "cv11" 1;
  -webkit-font-smoothing: antialiased;
}
.backdrop, .art { position: absolute; inset: 0; width: 100%; height: 100%; }
/* ---- Photo: real colour, full width, fading into the background where the words begin ---- */
.photo { position: absolute; left: 0; right: 0; top: 0; height: var(--ph); background-size: cover; background-position: center 30%;
  filter: saturate(.94) contrast(1.04); }
.photo-fade { position: absolute; left: 0; right: 0; top: 0; height: var(--ph);
  background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 92%, transparent) 0, color-mix(in srgb, var(--bg) 62%, transparent) 11%, transparent 24%,
                              transparent 46%, color-mix(in srgb, var(--bg) 82%, transparent) 84%, var(--bg) 100%); }
/* Photo credit: small, vertical, in the right margin over the photo, clear of the text column */
.credit { position: absolute; right: 26px; top: 150px; white-space: nowrap;
  writing-mode: vertical-rl; rotate: 180deg; font: 500 15px "Inter"; color: #fff; opacity: .85; letter-spacing: .02em;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .7); }
/* ---- Frame ---- */
.top { position: absolute; left: var(--m); right: var(--m); top: 64px; display: flex; justify-content: space-between; align-items: center; z-index: 2; }
.tag { display: inline-block; padding: 11px 16px 10px; border-radius: 4px; background: var(--tag-bg); color: var(--tag-ink);
  font: 800 22px/1 "Inter Tight"; letter-spacing: .08em; text-transform: uppercase; }
.tag--red { background: var(--tag-bg); color: var(--tag-ink); }
.tag--green { background: var(--chai-600); color: #fff; }
.tag--ink { background: var(--ink-950); color: #fff; }
.meta { font: 700 22px/1 "Inter Tight"; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.layer { position: absolute; inset: 0; padding: 168px var(--m) 176px; display: flex; flex-direction: column; }
.has-photo .layer { padding-top: calc(var(--ph) - 150px); }
.label { font: 800 22px/1.2 "Inter Tight"; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; }
.display { font-family: "Inter Tight", sans-serif; font-weight: 800; letter-spacing: -.025em; line-height: 1.0; color: var(--fg); }
.body { font: 500 32px/1.38 "Inter"; color: var(--soft); }
.lead { font: 600 36px/1.32 "Inter"; color: var(--fg); }
.strong { font: 700 32px/1.3 "Inter Tight"; color: var(--fg); letter-spacing: -.01em; }
.rule { height: 2px; background: var(--line); margin: 36px 0; flex: none; transform-origin: left; }
.gap { flex: 1 1 auto; min-height: 24px; }
.hl { color: var(--accent); }
/* The red marker: the words that hit hardest, chosen by the writer with *asterisks* */
mark { background: var(--mark-bg); color: var(--mark-ink); padding: 0 .1em; margin: 0 -.02em; border-radius: .06em;
  -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.rows { display: grid; }
.row { display: grid; grid-template-columns: 68px 1fr; gap: 8px; padding: 22px 0; border-top: 2px solid var(--line);
  font: 600 31px/1.32 "Inter"; color: var(--fg); }
.row:last-child { border-bottom: 2px solid var(--line); }
.row .n { font: 800 26px/1.5 "Inter Tight"; color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: .02em; }
.foot { position: absolute; left: var(--m); right: var(--m); bottom: 58px; padding-top: 26px; border-top: 2px solid var(--line);
  display: flex; justify-content: space-between; align-items: center; font: 700 22px/1 "Inter Tight"; letter-spacing: .02em; color: var(--muted); }
.foot img { height: 30px; display: block; }
{% block style %}{% endblock %}
{{ ink_css }}
{% if motion %}
/* ---- Motion: calm and quick. Things rise into place in reading order; numbers count; rules draw. ---- */
@keyframes enter { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
@keyframes word { from { opacity: 0; translate: 0 .32em; } to { opacity: 1; translate: 0 0; } }
@keyframes draw { from { scale: 0 1; } to { scale: 1 1; } }
@keyframes settle { from { scale: 1.08; } to { scale: 1; } }
@keyframes tailin { from { opacity: 0; } to { opacity: 1; } }
/* The hook must be on screen from frame 0: nothing starts invisible for longer than ~0.1s */
.layer > *, .top > * { animation: enter .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * .08s - .24s); }
.layer > .rule { animation-name: draw; animation-duration: .7s; }
.photo { animation: settle 1.6s cubic-bezier(.2, .8, .2, 1) both; }
.w { display: inline-block; animation: word .4s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--t0, 0s) + var(--w) * .045s); }
/* Legacy comics (out of rotation, still renderable) */
.panel { animation: enter .55s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--p) * 1.7s + .1s); }
.layer > .bub, .layer > .pnum, .layer > .punch { animation-delay: var(--bd, 0s) !important; }
{% endif %}
{% if reel %}
.reel { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: {{ bg }}; }
/* 9:16 safe zone: clear of the platform UI (top bar, right-hand buttons, bottom caption) */
.reel .canvas { position: absolute; left: 58px; top: 330px; overflow: visible; background: transparent; transform: scale(.84); transform-origin: 0 0; }
.reel .art, .reel .backdrop { overflow: visible; }
.reel-top { position: absolute; left: 0; right: 0; top: 215px; display: flex; justify-content: center; }
.reel-top img { height: 44px; }
{% endif %}
</style>
</head>
<body>
{% if reel %}<div class="reel" id="reel"><div class="reel-top"><img src="{{ logo_on_dark if dark else logo_on_light }}" alt=""></div>{% endif %}
<div class="canvas{{ ' has-photo' if photo_uri is defined }}" id="canvas">
  {% if photo_uri is defined %}<div class="photo" style="background-image: url('{{ photo_uri }}')"></div><div class="photo-fade"></div>{% endif %}
  <svg class="backdrop" viewBox="0 0 {{ W }} {{ H }}" preserveAspectRatio="none">{% block backdrop %}{% endblock %}</svg>
  <svg class="art" viewBox="0 0 {{ W }} {{ H }}" preserveAspectRatio="none">{% block art %}{% endblock %}</svg>
  <div class="layer">{% block content %}{% endblock %}</div>
  <div class="top">{% block top %}{% endblock %}</div>
  {% if photo_uri is defined and photo_credit %}<span class="credit">{{ photo_credit }}</span>{% endif %}
  {% block footer %}
  <div class="foot">
    <img src="{{ logo_on_dark if dark else logo_on_light }}" alt="Jua Kesho">
    <span>{{ brand.handle }}</span>
  </div>
  {% endblock %}
</div>
{% if reel %}</div>{% endif %}
<script>
  // Auto-fit: if the column runs into the footer zone, shrink headlines first (to 72%), then all text (to 86%).
  // Runs once the fonts are in (render.py and video.py call it), so the measurement is real.
  window.__fit = () => {
    const layer = document.querySelector('.layer');
    if (!layer || !layer.children.length) return 1;
    const cs = getComputedStyle(layer);
    const limit = layer.clientHeight - parseFloat(cs.paddingBottom);
    const over = () => Math.max(...[...layer.children].map((c) => c.offsetTop + c.offsetHeight)) - limit > 0.5;
    if (!over()) return 1;
    const all = [layer, ...layer.querySelectorAll('*')].filter((el) => !(el instanceof SVGElement));
    const base = new Map(all.map((el) => [el, parseFloat(getComputedStyle(el).fontSize)]));
    const heads = all.filter((el) => el.matches('.display, .display *'));
    const set = (els, k) => els.forEach((el) => { el.style.fontSize = (base.get(el) * k).toFixed(2) + 'px'; });
    let kh = 1, kb = 1;
    // smallest elements first so children don't inherit twice: explicit px on every element
    while (over() && kh > 0.72) { kh -= 0.02; set(heads, kh); }
    const rest = all.filter((el) => !heads.includes(el));
    while (over() && kb > 0.86) { kb -= 0.02; set(rest, kb); }
    return Math.min(kh, kb);
  };
</script>
{% if motion %}
<script>
  // Stagger order = reading order: the top bar first, then the column. Headlines are split into words.
  [...document.querySelectorAll('.top > *'), ...document.querySelectorAll('.layer > *')].forEach((el, i) => el.style.setProperty('--i', i));
  const bubs = [...document.querySelectorAll('.layer > .bub')];
  document.querySelectorAll('path.tail').forEach((t, k) => {
    const bd = bubs[k] ? parseFloat(bubs[k].style.getPropertyValue('--bd')) : NaN;
    const i = bubs[k] ? parseFloat(bubs[k].style.getPropertyValue('--i')) || 0 : 0;
    t.style.animation = `tailin .3s ease-out ${(isNaN(bd) ? i * 0.12 + 0.05 : bd + 0.18).toFixed(2)}s both`;
  });
  document.querySelectorAll('.layer h1').forEach((h) => {
    const parent = h.closest('.layer > *');
    // the first headline is the hook: its words start at frame 0
    const t0 = h === document.querySelector('.layer h1') ? 0 : Math.max(0, (parseFloat(getComputedStyle(parent).getPropertyValue('--i')) || 0) * 0.08 - 0.24);
    let n = 0;
    const walk = (node) => {
      [...node.childNodes].forEach((c) => {
        if (c.nodeType === 3) {
          const frag = document.createDocumentFragment();
          c.textContent.split(/(\s+)/).forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) { frag.append(part); return; }
            const s = document.createElement('span');
            s.className = 'w'; s.textContent = part;
            s.style.setProperty('--w', n++); s.style.setProperty('--t0', t0 + 's');
            frag.append(s);
          });
          c.replaceWith(frag);
        } else if (c.nodeType === 1 && !c.classList.contains('w')) walk(c);
      });
    };
    walk(h);
    if (parent === h) h.style.animation = 'none';  // the words animate instead of the whole block
  });
  // Numbers count up (Sh304bn rolls from Sh0bn): the size of a number lands harder when you watch it grow
  const ticks = [];
  document.querySelectorAll('[data-count]').forEach((el) => {
    const m = el.textContent.trim().match(/^(\D*?)([\d][\d,]*\.?\d*)(.*)$/);
    if (!m) return;
    const [, pre, num, post] = m, target = parseFloat(num.replace(/,/g, '')), dec = (num.split('.')[1] || '').length;
    const fmt = (v) => (num.includes(',') ? v.toLocaleString('en-US', {minimumFractionDigits: dec, maximumFractionDigits: dec}) : v.toFixed(dec));
    const t0 = 0.25, t1 = 1.45;
    ticks.push((t) => { const k = Math.min(1, Math.max(0, (t - t0) / (t1 - t0))); const e = 1 - Math.pow(1 - k, 3);
                        el.textContent = pre + fmt(target * e) + post; });
  });
  window.__motionEnd = () => {
    let end = 0;
    document.getAnimations().forEach((a) => {
      const t = a.effect.getComputedTiming();
      if (t.iterations !== Infinity) end = Math.max(end, t.endTime);
    });
    return end / 1000;
  };
  window.__seek = (t) => {
    document.getAnimations().forEach((a) => { a.pause(); a.currentTime = t * 1000; });
    ticks.forEach((f) => f(t));
    document.querySelectorAll('svg').forEach((s) => { if (s.pauseAnimations) { s.pauseAnimations(); s.setCurrentTime(t); } });
  };
</script>
{% endif %}
</body>
</html>
