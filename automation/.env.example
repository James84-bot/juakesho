# Copy to .env for local runs. In GitHub, add these as repository secrets instead.

# Drafting. Free: a Gemini API key from aistudio.google.com/apikey (no card). If both keys are set, Gemini is used
# unless JUA_PROVIDER=anthropic. (GitHub Models, the old free writer, was retired by GitHub on 30 July 2026.)
GEMINI_API_KEY=
JUA_GEMINI_MODEL=
# Paid, best Kenyan voice, capped by JUA_WEEKLY_BUDGET_USD (default $0.50 a week):
JUA_PROVIDER=
ANTHROPIC_API_KEY=
# Only if the API says the key "is not scoped to a workspace": console → Settings → Workspaces → copy the ID.
# (Or create the key inside a workspace instead, and leave this empty.)
ANTHROPIC_WORKSPACE_ID=
# Optional model override (Claude only), e.g. claude-sonnet-5
JUA_MODEL=

# Approval: create a bot with @BotFather, send it "hi", then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (message.chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publishing, comments and insights: Instagram Business account linked to a Facebook Page. A non-expiring Page token
# with pages_show_list, pages_read_engagement, pages_manage_posts, pages_manage_engagement, instagram_basic,
# instagram_content_publish, instagram_manage_comments, instagram_manage_insights, business_management (see README).
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v26.0

# Optional extra photo source (free: pexels.com/api). Wikimedia Commons and Openverse need no key.
PEXELS_API_KEY=

# Where exports/ is publicly reachable (Instagram fetches images and videos from here).
# Use GitHub Pages (Settings → Pages → Deploy from branch: main / root). raw.githubusercontent.com can
# serve files as text/plain, which Instagram rejects; the publisher checks this before every post.
PUBLIC_BASE_URL=https://<user>.github.io/<repo>
